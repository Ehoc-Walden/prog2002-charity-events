# Default local configuration for the API.
#
# api/.env is created from this file automatically the first time the API
# starts, so a freshly downloaded copy needs no manual setup step.
#
# DB_USER / DB_PASSWORD match the read-only MySQL account that
# api/database/schema.sql creates when it is imported with an administrative
# login. The API only ever issues SELECT statements, so a read-only grant is
# sufficient. Change these values only if you use a different MySQL account.
DB_HOST=localhost
DB_PORT=3306
DB_USER=charity_app
DB_PASSWORD=change_me
DB_NAME=charityevents_db
PORT=3000
# Every port that serves the client must be listed here. The documented client
# command uses port 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
